# Compose environment (DOC-39 §5). `make secrets` copies this file to .env at the repository root and fills every
# variable marked `# generate: <kind>`. Values are never committed: this file only lists names.

# --- Compose
COMPOSE_PROJECT_NAME=
PTI_IMAGE_TAG=
GHCR_OWNER=

# --- PostgreSQL superusers (bootstrap and `make psql-* SU=1` only)
# generate: password
PG_WAREHOUSE_SUPERUSER_PASSWORD=
# generate: password
PG_SOURCE_SUPERUSER_PASSWORD=

# --- Database roles (DOC-17 §6)
# generate: password
PTI_OWNER_PASSWORD=
# generate: password
ETL_WRITER_PASSWORD=
# generate: password
TRIAGE_WRITER_PASSWORD=
# generate: password
API_READER_PASSWORD=
# generate: password
REPLAY_OPERATOR_PASSWORD=
# generate: password
EXPERIMENT_RUNNER_PASSWORD=
# generate: password
TICKETING_OWNER_PASSWORD=
# generate: password
SIM_OWNER_PASSWORD=
# generate: password
SOURCE_SIMULATOR_PASSWORD=
# generate: password
DEBEZIUM_PASSWORD=

# --- Kafka (changing it after the volume exists stops Kafka from starting; `make reset` if needed)
# generate: kafka-cluster-id
KAFKA_CLUSTER_ID=

# --- S3 identities (DOC-39 §3.5)
# generate: s3-access-key
S3_ADMIN_ACCESS_KEY=
# generate: s3-secret-key
S3_ADMIN_SECRET_KEY=
# generate: s3-access-key
S3_CONNECT_ACCESS_KEY=
# generate: s3-secret-key
S3_CONNECT_SECRET_KEY=
# generate: s3-access-key
S3_ETL_ACCESS_KEY=
# generate: s3-secret-key
S3_ETL_SECRET_KEY=

# --- Keycloak
# generate: password
KEYCLOAK_ADMIN_PASSWORD=
# generate: password
KEYCLOAK_EXPERIMENTS_CLIENT_SECRET=
# Demo users of realm pti (DOC-27 §3.1). Public by design (AR-01): leave empty and the password is the user name;
# set a value to override it. Read by realm-pti.json at import, so `make restart S=keycloak` applies a change.
KEYCLOAK_DEMO_VIEWER_PASSWORD=
KEYCLOAK_DEMO_OPERATOR_PASSWORD=

# --- Alerting and Grafana
# generate: password
ALERTMANAGER_WEBHOOK_TOKEN=
# generate: password
GRAFANA_ADMIN_PASSWORD=

# --- Jev (optional; leave empty to use the fake provider)
TYPESAFE_API_KEY=
PTI_TRIAGE_PROVIDER=

# --- Behaviour (set by Makefile targets such as `make clock-offset` and `make up-demo`)
PTI_CLOCK_OFFSET=
PTI_EXTRA_PROFILES=
PTI_ETL_EXTRA_PROFILES=
PTI_TRACING_ENABLED=
PTI_WAREHOUSE_HOST=
PTI_DQ_MAX_CLOCK_SKEW=
PTI_SIM_START_RATE=

# --- Frontend map (ADR-0021): offline uses the PMTiles of deploy/tiles/; online needs the tile server's origin(s)
PTI_MAP_STYLE=
PTI_MAP_TILE_ORIGINS=

# --- Host ports (defaults in DOC-38 §5; every port binds to 127.0.0.1)
HOST_PORT_FRONTEND=
HOST_PORT_API=
HOST_PORT_SIM=
HOST_PORT_KEYCLOAK=
HOST_PORT_KAFKA=
HOST_PORT_CONNECT=
HOST_PORT_PG_WAREHOUSE=
HOST_PORT_PG_SOURCE=
HOST_PORT_S3=
HOST_PORT_S3_FILER=
HOST_PORT_GRAFANA=
HOST_PORT_PROMETHEUS=
HOST_PORT_ALERTMANAGER=
HOST_PORT_MAILPIT=
HOST_PORT_ALLOY=
HOST_PORT_TOXIPROXY=
