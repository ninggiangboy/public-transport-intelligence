      "targets": [
        {
          "expr": "100 * sum(rate(pti_etl_records_total{mode=\"stream\",outcome=\"skipped\"}[5m])) / clamp_min(sum(rate(pti_etl_records_total{mode=\"stream\"}[5m])), 1e-9)",
