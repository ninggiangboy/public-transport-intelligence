{
  "uid": "pti-overview",
  "title": "Pipeline overview",
  "tags": [
    "pti",
    "pipeline"
  ],
  "description": "Throughput, DLQ, lag, latency stages, listener and source health (DOC-28 \u00a77).",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Scenarios",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "sum by (scenario) (pti_sim_scenario_active) > 0",
        "step": "30s",
        "titleFormat": "Scenario {{scenario}}",
        "textFormat": "running",
        "useValueForTime": false
      },
      {
        "name": "Experiments",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "experiment"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Records written/s",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(pti_etl_records_total{mode=\"stream\",outcome=\"written\"}[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
