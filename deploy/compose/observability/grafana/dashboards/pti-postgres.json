{
  "uid": "pti-postgres",
  "title": "Postgres",
  "tags": [
    "pti",
    "postgres"
  ],
  "description": "Connection pools from the apps, warehouse statistics read as api_reader (DOC-28 \u00a77).",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hikaricp_connections_active, application)",
          "refId": "application"
        },
        "definition": "label_values(hikaricp_connections_active, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Scenarios",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "sum by (scenario) (pti_sim_scenario_active) > 0",
        "step": "30s",
        "titleFormat": "Scenario {{scenario}}",
        "textFormat": "running",
        "useValueForTime": false
      },
      {
        "name": "Experiments",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "experiment"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Connection pools",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active and pending connections",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application, pool) (hikaricp_connections_active{application=~\"$application\"})",
          "legendFormat": "active {{application}}/{{pool}}",
          "refId": "A",
          "range": true
        },
        {
          "expr": "sum by (application, pool) (hikaricp_connections_pending{application=~\"$application\"})",
          "legendFormat": "pending {{application}}/{{pool}}",
          "refId": "B",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection acquire time (avg)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application, pool) (rate(hikaricp_connections_acquire_seconds_sum{application=~\"$application\"}[5m])) / clamp_min(sum by (application, pool) (rate(hikaricp_connections_acquire_seconds_count{application=~\"$application\"}[5m])), 1e-9)",
          "legendFormat": "{{application}}/{{pool}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Chunk duration p95",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(pti_etl_chunk_duration_seconds_bucket[5m])))",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection timeouts",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application, pool) (increase(hikaricp_connections_timeout_total{application=~\"$application\"}[5m]))",
          "legendFormat": "{{application}}/{{pool}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Warehouse (pg_stat_*)",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Sessions by state",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pti-warehouse"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pti-warehouse"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(state, 'background') AS state, usename AS role, count(*) AS sessions\nFROM pg_stat_activity WHERE datname = 'pti_warehouse'\nGROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Transactions and cache",
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pti-warehouse"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pti-warehouse"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT xact_commit AS commits, xact_rollback AS rollbacks,\n  round(100.0 * blks_hit / greatest(blks_hit + blks_read, 1), 2) AS cache_hit_pct,\n  deadlocks, temp_files, pg_size_pretty(temp_bytes) AS temp_bytes\nFROM pg_stat_database WHERE datname = 'pti_warehouse'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Lock waits",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pti-warehouse"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pti-warehouse"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT l.mode, l.locktype, count(*) AS waiting\nFROM pg_locks l\nJOIN pg_stat_activity a ON a.pid = l.pid AND a.datname = 'pti_warehouse'\nWHERE NOT l.granted GROUP BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Fact partitions: size, dead tuples, autovacuum",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pti-warehouse"
      },
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pti-warehouse"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT relname AS partition, pg_size_pretty(pg_total_relation_size(relid)) AS size,\n  n_live_tup AS live, n_dead_tup AS dead, last_autovacuum, last_autoanalyze\nFROM pg_stat_user_tables\nWHERE schemaname = 'dw' AND (relname LIKE 'fact_%' OR relname = 'vehicle_position_latest')\nORDER BY pg_total_relation_size(relid) DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
