# Server of the pti-frontend image (DOC-39, DOC-26 §10, DOC-27 §5.3). 40-pti-runtime-config.sh renders this file
# into /etc/nginx/conf.d/default.conf at startup; only the ${PTI_*} and ${NGINX_LOCAL_RESOLVERS} placeholders are
# replaced, nginx variables are left alone.

server_tokens off;

# The api is resolved per request, so the frontend starts without it and follows a recreated api container.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 80;
  root /usr/share/nginx/html;

  # Security headers of DOC-27 §5.3 on every response, /api/ included. add_header_inherit (nginx 1.29.3+) keeps them
  # in locations that add their own Cache-Control.
  add_header_inherit merge;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Content-Security-Policy "${PTI_CSP}" always;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  set $pti_api ${PTI_API_UPSTREAM};
  # The api sets these two itself (Spring Security); the server-level headers above already carry them.
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header X-Frame-Options;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Rendered at startup from the container's environment (DOC-34 §10).
  location = /env.js {
    add_header Cache-Control "no-store" always;
  }

  # Vite puts a content hash in every file name under /assets/.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # PMTiles, fonts and sprites of the offline basemap (ADR-0021), mounted read-only; nginx serves range requests.
  location /tiles/ {
    add_header Cache-Control "public, max-age=86400";
    try_files $uri =404;
  }

  # Server-sent events: no buffering, no gzip, an hour between reads (DOC-26 §10).
  location = /api/v1/stream {
    proxy_pass $pti_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    gzip off;
  }

  location /api/ {
    proxy_pass $pti_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Never expose the Alertmanager webhook (DOC-27).
  location /internal/ {
    return 404;
  }

  # SPA: every other path is a route of the app, which renders its own 404 page.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
