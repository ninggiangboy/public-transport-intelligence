{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pti.dev/schemas/envelope.schema.json",
  "title": "GTFS-realtime message envelope (DOC-09 §2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "entity_type",
    "source",
    "event_timestamp",
    "produced_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_type": {
      "enum": [
        "VEHICLE_POSITION",
        "TRIP_UPDATE"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "event_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "payload": {
      "type": "object"
    }
  }
}
