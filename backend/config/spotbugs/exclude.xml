<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    Constructor injection stores and exposes collaborators by design; these two patterns fire on every Spring bean
    (DOC-11 §1.2).
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- A Jackson 3 JsonMapper is immutable once built, so sharing the message mapper exposes nothing. -->
  <Match>
    <Class name="dev.pti.common.json.MessageJson"/>
    <Method name="mapper"/>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
